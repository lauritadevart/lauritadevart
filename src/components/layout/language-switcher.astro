---
// Language switcher — links to the equivalent page in the other locale.
// Renders as a fixed pill; relies on Astro ClientRouter for instant, no-reload switches.
import { LOCALES, LOCALE_LABELS, localizePath, localeFromPath, type Locale } from '@/i18n'

interface Props {
  pathname: string
  locale: Locale
}

const { pathname, locale } = Astro.props

const target: Locale = locale === 'en' ? 'es' : 'en'
const targetPath = localizePath(pathname, target)
const label = target === 'es' ? 'Ver en Español' : 'View in English'
---

<div class='fixed top-4 right-4 z-70 print:hidden'>
  <a
    href={targetPath}
    hreflang={target}
    aria-label={label}
    class='bg-card text-foreground ring-border inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium shadow-sm ring-1 transition-colors hover:text-accent'
  >
    <svg
      xmlns='http://www.w3.org/2000/svg'
      viewBox='0 0 24 24'
      fill='none'
      stroke='currentColor'
      stroke-width='2'
      stroke-linecap='round'
      stroke-linejoin='round'
      class='size-3.5'
      aria-hidden='true'
    >
      <circle cx='12' cy='12' r='10'></circle>
      <path d='M2 12h20'></path>
      <path d='M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z'></path>
    </svg>
    {LOCALE_LABELS[target]}
  </a>
</div>
