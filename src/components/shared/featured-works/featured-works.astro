---
import Eyebrow from '@/components/shared/eyebrow/eyebrow.astro'
import FeaturedWorkCard from '@/components/shared/featured-works/featured-work-card.astro'

import { cn } from '@/lib/utils'
import type { CaseStudyMetadata } from '@/lib/case-studies'
import { useTranslations, type Locale } from '@/i18n'

interface Props {
  caseStudies: CaseStudyMetadata[]
  id?: string
  eyebrow?: string
  title?: string
  layout?: 'bento' | 'vertical'
  showBorder?: boolean
  locale?: Locale
}

const {
  caseStudies,
  id = 'featured-works',
  eyebrow,
  title,
  layout = 'bento',
  showBorder = true,
  locale = 'en'
} = Astro.props

const t = useTranslations(locale)
const resolvedEyebrow = eyebrow ?? t.work.eyebrow
const resolvedTitle = title ?? t.work.title

const CYCLE_SIZE = 3

const chunkIntoCycles = (items: CaseStudyMetadata[]): CaseStudyMetadata[][] => {
  const cycles: CaseStudyMetadata[][] = []

  for (let i = 0; i < items.length; i += CYCLE_SIZE) {
    cycles.push(items.slice(i, i + CYCLE_SIZE))
  }

  return cycles
}

const cycles = chunkIntoCycles(caseStudies)
---

<section id={id} class={cn('py-8 sm:py-16 lg:py-24', showBorder && 'border-b')}>
  <div class='mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:space-y-16 lg:px-10.5'>
    <div class='space-y-2'>
      <Eyebrow text={resolvedEyebrow} />
      <h2 class='text-2xl font-semibold md:text-3xl lg:text-4xl'>{resolvedTitle}</h2>
    </div>

    {
      layout === 'vertical' ? (
        <div class='grid gap-8 sm:grid-cols-2'>
          {caseStudies.map(caseStudy => (
            <FeaturedWorkCard caseStudy={caseStudy} variant='grid' locale={locale} />
          ))}
        </div>
      ) : (
        <div class='space-y-8'>
          {cycles.map((cycle, cycleIndex) => (
            <div class='space-y-8'>
              <FeaturedWorkCard
                caseStudy={cycle[0]}
                variant='hero'
                imageSide={cycleIndex % 2 === 0 ? 'right' : 'left'}
                locale={locale}
              />

              {cycle.length > 1 && (
                <div class='grid gap-8 sm:grid-cols-2'>
                  {cycle.slice(1).map(caseStudy => (
                    <FeaturedWorkCard caseStudy={caseStudy} variant='grid' locale={locale} />
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
