---
import { Hand } from 'lucide-react'

import AvailabilityBadge from '@/components/shared/availability-badge'
import GreetingWord from '@/components/home/hero/greeting-word'
import HeroCta from '@/components/home/hero/hero-cta'
import IdCard from '@/components/ui/id-card'
import { useTranslations, type Locale } from '@/i18n'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const t = useTranslations(locale)
---

<section class='lg:relative'>
  <div class='border-b pb-8 max-sm:pt-20 sm:py-16 lg:pt-32 lg:pb-24'>
    <div class='px-4 sm:px-6 lg:px-10.5'>
      <div class='space-y-6 lg:max-w-lg'>
        <AvailabilityBadge className='h-6.5 gap-1 rounded-full' text={t.common.availableForWork} locale={locale} />
        <h1 class='mb-2 text-4xl font-semibold tracking-tight sm:text-5xl lg:text-[64px] lg:font-bold'>
          <GreetingWord client:load locale={locale} />{t.hero.name}
          <Hand className='text-accent ml-2 inline-block size-9 animate-wiggle align-middle sm:size-11' strokeWidth={2.2} />
        </h1>
        <p class='text-muted-foreground text-xl font-medium sm:text-2xl lg:text-3xl'>{t.hero.role}</p>
        <p class='text-accent text-lg font-medium sm:text-xl'>{t.hero.subtitle}</p>
        <p class='mb-8 max-w-2xl text-base'>{t.hero.intro}</p>
        <HeroCta locale={locale} />
      </div>
    </div>
  </div>

  <!-- client:only — WebGL/Canvas can't SSR -->
  <IdCard
    client:only='react'
    frontImage='/images/3d-card/profile.webp'
    aria-label={t.hero.cardAlt}
    className='mx-auto mt-8 aspect-4/5 w-full max-w-80 max-lg:hidden lg:absolute lg:-top-31 lg:right-0 lg:left-0 lg:z-10 lg:mt-0 lg:aspect-auto lg:h-192 lg:max-w-none'
  />
</section>
