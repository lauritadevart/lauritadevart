---
import Eyebrow from '@/components/shared/eyebrow/eyebrow.astro'
import Credentials from '@/components/home/about/credentials.astro'
import { useTranslations, type Locale } from '@/i18n'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const t = useTranslations(locale)
---

<section id='about' class='border-b py-8 sm:py-16 lg:py-24'>
  <div class='mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:space-y-12 lg:px-10.5'>
    <div class='space-y-2'>
      <Eyebrow text={t.about.eyebrow} />
      <h2 class='text-2xl font-semibold md:text-3xl lg:text-4xl'>{t.about.title}</h2>
    </div>

    <div class='grid gap-6 text-base md:grid-cols-2'>
      <p class='text-muted-foreground'>{t.about.summary}</p>
      <p class='text-muted-foreground'>{t.about.summary2}</p>
    </div>

    <Credentials locale={locale} />
  </div>
</section>