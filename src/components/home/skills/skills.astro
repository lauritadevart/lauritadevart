---
// Skills section — surfaces the technical stack from the résumé in scannable cards.
import Eyebrow from '@/components/shared/eyebrow/eyebrow.astro'
import { Card, CardContent } from '@/components/ui/card'
import { useTranslations, type Locale } from '@/i18n'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const t = useTranslations(locale)
---

<section id='skills' class='border-b py-8 sm:py-16 lg:py-24'>
  <div class='mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:space-y-16 lg:px-10.5'>
    <div class='space-y-2'>
      <Eyebrow text={t.skills.eyebrow} />
      <h2 class='text-2xl font-semibold md:text-3xl lg:text-4xl'>{t.skills.title}</h2>
    </div>

    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3'>
      {
        t.skills.categories.map(category => (
          <Card className='ring-border gap-0 rounded-[24px] bg-(--background-darker) shadow-none'>
            <CardContent className='space-y-2 p-6'>
              <h3 class='text-accent text-lg font-semibold'>{category.name}</h3>
              <p class='text-muted-foreground text-base'>{category.items}</p>
            </CardContent>
          </Card>
        ))
      }
    </div>
  </div>
</section>
