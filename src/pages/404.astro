---
import NotFound from '@/components/not-found'
import BlankLayout from '@/layouts/BlankLayout.astro'
import { localeFromPath } from '@/i18n'

// Detect locale from the requested path so the 404 shows the right language.
const locale = localeFromPath(Astro.url.pathname)

const pageTitle = '404'
const pageDescription =
  locale === 'es' ? 'La página que buscas no existe.' : 'The page you are looking for does not exist.'
---

<BlankLayout title={pageTitle} description={pageDescription} noindex nofollow locale={locale}>
  <NotFound locale={locale} />
</BlankLayout>
